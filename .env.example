# Application
APP_NAME="MWAMBE Agency"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mwambeagency.org
APP_TIMEZONE=Africa/Blantyre
APP_KEY=

# Database (cPanel MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mwambe_db
DB_USER=mwambe_user
DB_PASS=
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=mwambe_session
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Mail (cPanel SMTP)
MAIL_HOST=mail.mwambeagency.org
MAIL_PORT=587
MAIL_USERNAME=mwambeagency@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=mwambeagency@gmail.com
MAIL_FROM_NAME="MWAMBE Agency"
MAIL_REPLY_TO=mwambeagency@gmail.com

# Security
CSRF_TOKEN_NAME=_csrf
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
UPLOAD_ALLOWED_DOC_TYPES=pdf,doc,docx